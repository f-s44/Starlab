#define kNOERROR 0
#define kREADERROR 1
#define kWRITEERROR 2
 
// --- UPDATED FOR PICO 2 SPI0 PINS ---
const uint16_t SPIChipSelectPin = 17; // Pico GP17
const uint16_t SCK_PIN = 18;          // Pico GP18
const uint16_t TX_PIN = 19;           // Pico GP19 (MOSI)
const uint16_t RX_PIN = 16;           // Pico GP16 (MISO)

// ------------------------------------

const uint16_t I2CAddress0 = 9;
const uint16_t I2CAddress1 = 11;
const uint16_t I2CAddress = 96;
const uint16_t ProtocolSelectPin = 15; // Moved off GP16 to avoid SPI conflict
 
const uint32_t WRITE = 0x00;
const uint32_t READ = 0x80;
const uint32_t COMMAND_MASK = 0x80;
const uint32_t ADDRESS_MASK = 0x7F;
 
unsigned long nextTime;
bool UseI2C = false;

volatile uint32_t latest_icodes = 0;
volatile float latest_current = 0.0;

void setup()
{
    pinMode(ProtocolSelectPin, INPUT_PULLUP);
    delay(50); 

 
    if (UseI2C)
    {
        // I2C Setup (Leaving as is, though you are using SPI)
        Wire.begin(); 
        Wire.setClock(100000);
        pinMode(I2CAddress0, OUTPUT);
        pinMode(I2CAddress1, OUTPUT);
        digitalWrite(I2CAddress0, LOW);
        digitalWrite(I2CAddress1, LOW);
    }
    else
    {
        // --- UPDATED PICO 2 SPI INITIALIZATION ---
        SPI.setSCK(SCK_PIN);
        SPI.setTX(TX_PIN);
        SPI.setRX(RX_PIN);
        SPI.begin(); 
 
        pinMode(SPIChipSelectPin, OUTPUT);
        digitalWrite(SPIChipSelectPin, HIGH);

        // Pico as I2C slave for Raspberry Pi
        Wire.setSDA(4);
        Wire.setSCL(5);
        Wire.begin(0x42);
        Wire.onRequest(sendDataToPi);
 
        uint32_t unused;
        Read(0x0, unused);
    }
 
    Write(0x2F, 0x4F70656E);   // Unlock device
    
    Serial.begin(115200);
    while (!Serial);
    
    if (UseI2C) {
        Serial.println("Using I2C version of ACS37800");
    } else {
        Serial.println("Using SPI version of ACS37800");
    }
 
    nextTime = millis();
}

 
