# ---------------- FUNCTION TO GET DATA ----------------
def get_voltage_current_bytes():
    packed_data = read_register(REG_POWER_DATA)

    vrms_raw = packed_data & 0xFFFF
    irms_raw = (packed_data >> 16) & 0xFFFF
    if irms_raw & 0x8000:
        irms_raw -= 0x10000

    voltage = vrms_raw * 0.84 * 1.19
    current = irms_raw * 15.0 * 1.19

    # Convert to bytes: 2 bytes voltage + 2 bytes current
    v_int = int(voltage * 100)  # multiply to preserve 2 decimals
    i_int = int(current * 100)
    return v_int.to_bytes(2, 'big') + i_int.to_bytes(2, 'big')
