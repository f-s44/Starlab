#include <SPI.h>
#include <Wire.h>


// --- Function Prototypes ---
uint16_t Read(uint8_t address, uint32_t& value);
uint16_t Write(uint8_t address, uint32_t value);
float ConvertUnsignedFixedPoint(uint32_t inputValue, uint16_t binaryPoint, uint16_t width);
float ConvertSignedFixedPoint(uint32_t inputValue, uint16_t binaryPoint, uint16_t width);
int32_t SignExtendBitfield(uint32_t data, uint16_t width);

void sendDataToPi();
void receiveFromPi(int len);
// ---------------------------
 
#define kNOERROR 0
#define kREADERROR 1
#define kWRITEERROR 2

// ---  PICO 2 I2C PINS ---
const uint16_t I2C_SDA = 4;         // Pico GP4
const uint16_t I2C_SCL = 5;         // Pico GP5

// I2C slave address
const uint8_t I2C_SLAVE_ADDR = 0x42;
 
// ---  PICO 2 SPI0 PINS ---
const uint16_t SPI_CS1 = 17;          // Pico GP17
const uint16_t SPI_CS2 = 20;          // Pico GP20
const uint16_t SPI_CS3 = 21;          // Pico GP21
const uint16_t SCK_PIN = 18;          // Pico GP18
const uint16_t TX_PIN = 19;           // Pico GP19 (MOSI)
const uint16_t RX_PIN = 16;           // Pico GP16 (MISO)
// ------------------------------------
//const uint16_t Current_CS = SPI_CS1;  
//const uint16_t Current_CS = SPI_CS2; 
const uint16_t Current_CS = SPI_CS3;           

 
const uint32_t WRITE = 0x00;
const uint32_t READ = 0x80;
const uint32_t COMMAND_MASK = 0x80;
const uint32_t ADDRESS_MASK = 0x7F;

// ACS37800 properties:
const float SensI = 916.7;                      // datasheet
const float SensV = 110.0;                      // datasheet
const float SFline2device = 6800.0/(6800.0+240000.0*4.0)*1000.0;    // voltage divider - MUST CHANGE FOR NEW DIVIDERS
const float SensI_Gain = 1.001984;                 // sensor dependent
const float SensV_Gain = 0.9008;                // sensor dependent
const float SensI_Offest = -0.009615;             // offest affected by changes in magnetic field
const float SensV_Offset = -0.00218;


// wire resistance:
const float Wire_resistance = 0.01;           // wire from sensor VREF to (-) load side (ohms)
//

unsigned long nextTime;

// Latest readings for I2C
volatile uint32_t latest_irms_raw = 0;
volatile float latest_current = 0.0;
volatile uint32_t latest_vrms_raw = 0;
volatile float latest_voltage = 0.0;
volatile uint8_t selectedRegister = 0x42;
volatile bool i2c_transfer_in_progress = false;

// ------------------- I2C Slave Handlers -------------------

void receiveFromPi(int len) {
    if (len > 0) {
        selectedRegister = Wire.read(); 
        while(Wire.available()) Wire.read();
    }
}

void sendDataToPi() {
    if (selectedRegister == 0x01) {
        uint8_t* ptr = (uint8_t*)&latest_irms_raw;
        Wire.write(ptr, 4);
    } 
    else if (selectedRegister == 0x02) {
        uint8_t* ptr = (uint8_t*)&latest_current;
        Wire.write(ptr, 4);
    } 
    else if (selectedRegister == 0x03) {
        uint8_t* ptr = (uint8_t*)&latest_voltage;
        Wire.write(ptr, 4);
    }
    else if (selectedRegister == 0x04) {
        // Send Raw VRMS (4 bytes, though only 16-bit used)
        uint8_t* ptr = (uint8_t*)&latest_vrms_raw;
        Wire.write(ptr, 4);
    }
    else if (selectedRegister == 0x05) {
        // Sending Voltage [0-3] then Current [4-7]
        float combined[2];
        combined[0] = latest_voltage;
        combined[1] = latest_current;
        uint8_t* ptr = (uint8_t*)&combined;
        Wire.write(ptr, 8);
    }
    else {
        uint32_t fail = 0xFFFFFFFF;
        Wire.write((uint8_t*)&fail, 4);
    }
}

void setup()
{
    Serial.begin(115200);

    // PICO 2 SPI INITIALIZATION
    SPI.setSCK(SCK_PIN);
    SPI.setTX(TX_PIN);
    SPI.setRX(RX_PIN);
    SPI.begin(); 
 
    pinMode(SPI_CS1, OUTPUT);
    pinMode(SPI_CS2, OUTPUT);
    pinMode(SPI_CS3, OUTPUT);
    digitalWrite(SPI_CS1, HIGH);
    digitalWrite(SPI_CS2, HIGH);
    digitalWrite(SPI_CS3, HIGH);

 
    uint32_t unused;
    Read(0x0, unused);


    Write(0x2F, 0x4F70656E);   // Unlock device


    // Enable DC averaging & set sample # to 1023
    uint32_t shadow1F = 0;
    Read(0x1F, shadow1F);

    // Clear out the old data in bits 24 down to 14
    shadow1F &= ~(0x7FFUL << 14);
    
    // Set bit 24 (bypass_n_en = 1) AND bits 23:14 (n = 1023)
    shadow1F |= (1UL << 24) | (1023UL << 14);
    Write(0x1F, shadow1F);
  
    // --- I2C Slave Setup ---
    Wire.setSDA(I2C_SDA);
    Wire.setSCL(I2C_SCL);
    Wire.begin(I2C_SLAVE_ADDR);
    Wire.onReceive(receiveFromPi);
    Wire.onRequest(sendDataToPi);

    nextTime = millis();
}

 
/*
 * Every 500 milliseconds, read the ACS37800 and print out the values
 */
void loop() {
    uint32_t v_i_v_rms_o;   // register containing VRMS and IRMS

    // Reads the ACS37800 every 500ms
    if (nextTime < millis())
    {
        Read(0x20, v_i_v_rms_o);
 
        // Extract the 16-bit VRMS and IRMS raw codes
        uint32_t vrms_raw = v_i_v_rms_o & 0xFFFF;
        uint32_t irms_raw = (v_i_v_rms_o >> 16) & 0xFFFF;

        // calculations, end Sens_Gain is sensor dependent
        float voltage = vrms_raw / (2 * SensV * SFline2device) * SensV_Gain + SensV_Offset;
        float current = irms_raw / (2 * SensI) * SensI_Gain + SensI_Offest;

        // wire resistance
        voltage = voltage - (current * Wire_resistance);

        // Print VRMS and IRMS
        Serial.printf("Raw V: %u | Voltage: %.2f V\n", vrms_raw, voltage);
        Serial.printf("Raw I: %u | Current: %.2f A\n", irms_raw, current);
        Serial.println("-----------------------------------\n");

        // Store latest readings for I2C
        latest_irms_raw = irms_raw;
        latest_current = current;
        latest_vrms_raw = vrms_raw;
        latest_voltage = voltage;
 
        nextTime = millis() + 500L;
    }
}

/*
 * Read a register
 *
 *    address   - the address to be written
 *    value     - the value that was read
 *    returns   - the error (0 otherwise)
 */
uint16_t Read(uint8_t address, uint32_t& value)
{
    uint16_t results = kNOERROR;
 

    SPI.beginTransaction(SPISettings(1000000, LSBFIRST, SPI_MODE3));

    // Combine the register address and the command into one byte
    uint8_t command = (address & ADDRESS_MASK) | READ;
 
    // take the chip select low to select the device
    digitalWrite(Current_CS, LOW);

    // send the device the register you want to read
    SPI.transfer(command);
    SPI.transfer(0);
    SPI.transfer(0);
    SPI.transfer(0);
    SPI.transfer(0);

    digitalWrite(Current_CS, HIGH);
    delayMicroseconds(4);
    digitalWrite(Current_CS, LOW);

    // send the command again to read the contents
    SPI.transfer(command);
    value = (uint32_t)SPI.transfer(0);
    value |= (uint32_t)SPI.transfer(0) << 8;
    value |= (uint32_t)SPI.transfer(0) << 16;
    value |= (uint32_t)SPI.transfer(0) << 24; // high byte

    // take the chip select high to de-select
    digitalWrite(Current_CS, HIGH);
 
    SPI.endTransaction();
 
    return results;
}
 
/*
 * Write a register
 *
 *    address   - the address to be written
 *    value     - the value to be written
 *    returns   - the error (0 otherwise)
 */
uint16_t Write(uint8_t address, uint32_t value)
{
    uint16_t results = kNOERROR;
 


    SPI.beginTransaction(SPISettings(1000000, LSBFIRST, SPI_MODE3));
 
    // Combine the register address and the command into one byte
    uint8_t command = ((address & ADDRESS_MASK) | WRITE);
 
    // take the chip select low to select the device:
    digitalWrite(Current_CS, LOW);
 
    // Send the command then the value (least significant byte first)
    SPI.transfer(command);
    SPI.transfer((uint8_t)value);
    SPI.transfer((uint8_t)(value >> 8));
    SPI.transfer((uint8_t)(value >> 16));
    SPI.transfer((uint8_t)(value >> 24));
 
    // take the chip select high to de-select:
    digitalWrite(Current_CS, HIGH);
 
    SPI.endTransaction();


    if (address < 0x10)
    {
        delay(30);  // If writing to EEPROM delay 30 ms
    }
 
    return results;
}
 
/*
 * Convert an unsigned bitfield which is right justified, into a floating point number
 *
 *    data        - the bitfield to be converted
 *    binaryPoint - the binary point (the bit to the left of the binary point)
 *    width       - the width of the bitfield
 *    returns     - the floating point number
 */
float ConvertUnsignedFixedPoint(uint32_t inputValue, uint16_t binaryPoint, uint16_t width)
{
    uint32_t mask;
 
    if (width == 32)
    {
        mask = 0xFFFFFFFF;
    }
    else
    {
        mask = (1UL << width) - 1UL;
    }
 
    return (float)(inputValue & mask) / (float)(1L << binaryPoint);
}
 
/*
 * Convert a signed bitfield which is right justified, into a floating point number
 *
 *    data        - the bitfield to be sign extended then converted
 *    binaryPoint - the binary point (the bit to the left of the binary point)
 *    width       - the width of the bitfield
 *    returns     - the floating point number
 */
float ConvertSignedFixedPoint(uint32_t inputValue, uint16_t binaryPoint, uint16_t width)
{
    int32_t signedValue = SignExtendBitfield(inputValue, width);
    return (float)signedValue / (float)(1L << binaryPoint); 
}
 
/*
 * Sign extend a bitfield which if right justified
 *
 *    data        - the bitfield to be sign extended
 *    width       - the width of the bitfield
 *    returns     - the sign extended bitfield
 */
int32_t SignExtendBitfield(uint32_t data, uint16_t width)
{
    // If the bitfield is the width of the variable, don't bother trying to sign extend (it already is)
    if (width == 32)
    {
        return (int32_t)data;
    }
 
    int32_t x = (int32_t)data;
    int32_t mask = 1L << (width - 1);
 
    x = x & ((1 << width) - 1); // make sure the upper bits are zero
 
    return (int32_t)((x ^ mask) - mask);
}
