import smbus2
import time
import struct

# --- I2C Setup ---
I2C_BUS = 1         
PICO_ADDR = 0x42   

bus = smbus2.SMBus(I2C_BUS)

REG_IRMS_RAW = 0x01  
REG_CURRENT  = 0x02  

def read_pico_data(register_addr):
    """
    Tells the Pico which register we want, then reads 4 bytes.
    """
    try:
        write = smbus2.i2c_msg.write(PICO_ADDR, [register_addr])
        read = smbus2.i2c_msg.read(PICO_ADDR, 4)
        
        bus.i2c_rdwr(write, read)
        
        data = list(read)
        return data
    except Exception as e:
        print(f"I2C Error: {e}")
        return None

print("Starting Pico I2C Reader...")
print("---------------------------")

while True:
    # 1. Read Raw IRMS (uint32_t)
    raw_data = read_pico_data(REG_IRMS_RAW)
    if raw_data:
        irms_raw = struct.unpack('<I', bytes(raw_data))[0]
    else:
        irms_raw = 0

    # 2. Read Calculated Current (float)
    float_data = read_pico_data(REG_CURRENT)
    if float_data:
        # 'f' is float (4 bytes), '<' is little-endian
        current_float = struct.unpack('<f', bytes(float_data))[0]
    else:
        current_float = 0.0

    # Print results
    print(f"Pico Raw IRMS: {irms_raw}")
    print(f"Pico Float Current: {current_float:.3f} A")
    print("---------------------------")
    
    time.sleep(0.5)
