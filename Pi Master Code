#define PICO 0x42

uint32_t readPico(uint8_t addr) {
    uint32_t value = 0;
    Wire.requestFrom(addr, (uint8_t)4);

    if (Wire.available() == 4) {
        value  = Wire.read();
        value |= Wire.read() << 8;
        value |= Wire.read() << 16;
        value |= Wire.read() << 24;
    }

    return value;
}

