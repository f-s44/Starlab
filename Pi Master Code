import smbus2
import time
import struct

# --- I2C Setup ---
I2C_BUS = 1         # Ensure this matches your i2cdetect bus
PICO_ADDR = 0x42   

bus = smbus2.SMBus(I2C_BUS)

# Register Map (Must match Pico C++ code)
REG_IRMS_RAW = 0x01  
REG_CURRENT  = 0x02  
REG_VOLTAGE  = 0x03  # Float Voltage
REG_VRMS_RAW = 0x04  # Raw Voltage

def read_pico_value(register_addr, fmt):
    """
    Reads 4 bytes from the Pico and unpacks them.
    fmt: 'I' for uint32 (Raw), 'f' for float (Calculated)
    """
    try:
        # Write register address, then read 4 bytes back
        write = smbus2.i2c_msg.write(PICO_ADDR, [register_addr])
        read = smbus2.i2c_msg.read(PICO_ADDR, 4)
        
        bus.i2c_rdwr(write, read)
        
        # Convert bytes to Python value (Little Endian)
        data_bytes = bytes(list(read))
        return struct.unpack(f'<{fmt}', data_bytes)[0]
    except Exception as e:
        # Silently return None on error to keep the loop running
        return None

print("Starting Pico I2C Reader (Voltage & Current)...")
print("Press Ctrl+C to stop.")
print("-----------------------------------------------")

while True:
    # 1. Read Current Data
    irms_raw = read_pico_value(REG_IRMS_RAW, 'I')
    current  = read_pico_value(REG_CURRENT, 'f')

    # 2. Read Voltage Data
    vrms_raw = read_pico_value(REG_VRMS_RAW, 'I')
    voltage  = read_pico_value(REG_VOLTAGE, 'f')

    # Display results if read was successful
    if None not in (irms_raw, current, vrms_raw, voltage):
        print(f"VOLTAGE: {voltage:6.2f} V  (Raw: {vrms_raw})")
        print(f"CURRENT: {current:6.3f} A  (Raw: {irms_raw})")
        print("-----------------------------------------------")
    else:
        print("I2C Error: Could not retrieve all registers. Check wiring.")

    time.sleep(0.5)
