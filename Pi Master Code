import smbus
import time

bus = smbus.SMBus(1)

PICO1 = 0x42
PICO2 = 0x43

def read_pico(addr):
    data = bus.read_i2c_block_data(addr, 0, 4)
    return data[0] | (data[1]<<8) | (data[2]<<16) | (data[3]<<24)

while True:
    val1 = read_pico(PICO1)
    val2 = read_pico(PICO2)

    print("Pico1:", val1, " | Pico2:", val2)
    time.sleep(0.5)
