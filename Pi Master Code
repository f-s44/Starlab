#include <Wire.h>

#define PICO1 0x42
#define PICO2 0x43

uint32_t readPico(uint8_t addr) {
    uint32_t value = 0;

    Wire.requestFrom(addr, (uint8_t)4);

    if (Wire.available() == 4) {
        value  = Wire.read();
        value |= Wire.read() << 8;
        value |= Wire.read() << 16;
        value |= Wire.read() << 24;
    }

    return value;
}

void setup() {
    Serial.begin(115200);
    Wire.begin();  // master mode
}

void loop() {
    uint32_t val1 = readPico(PICO1);
    uint32_t val2 = readPico(PICO2);

    Serial.print("Pico1: ");
    Serial.print(val1);
    Serial.print(" | Pico2: ");
    Serial.println(val2);

    delay(500);
}
